#!/bin/sh
# postinst bitsnetworksbot
# Bersihkan cache LuCI, aktifkan servis procd, dan best-effort pasang
# python-telegram-bot bila belum ada (non-fatal, latar-belakang).

[ -z "$IPKG_INSTROOT" ] && {
	rm -rf /tmp/luci-indexcache /tmp/luci-modulecache /tmp/.uci

	# Aktifkan servis procd (bukan start — bot butuh token dulu).
	if [ -x /etc/init.d/bitsnetworksbot ]; then
		/etc/init.d/bitsnetworksbot enable >/dev/null 2>&1
	fi

	# python-telegram-bot tidak ada di feed OpenWrt resmi; diinstal lewat pip.
	# Usahakan pemasangan otomatis bila pip tersedia; non-fatal.
	if ! python3 -c "import telegram" >/dev/null 2>&1 && command -v pip3 >/dev/null 2>&1; then
		( pip3 install --no-cache-dir python-telegram-bot >/tmp/bitsnetworksbot-pip.log 2>&1 & )
	fi

	# Responsive fix: theme tidak handle input[type=password] di mobile.
	# Suntik CSS ke custom.css tema (idempotent).
	_bnb_marker="/* bitsnetworksbot responsive */"
	for _bnb_dir in /www/luci-static/*; do
		[ -d "$_bnb_dir" ] || continue
		_bnb_css="$_bnb_dir/custom.css"
		if ! grep -q "$_bnb_marker" "$_bnb_css" 2>/dev/null; then
			cat >> "$_bnb_css" <<'CSS'

/* bitsnetworksbot responsive */
@media (max-width: 600px) {
    .cbi-value input[type="password"] { width: 100% !important; min-width: 0 !important; }
}
CSS
		fi
	done
	rm -rf /tmp/luci-indexcache /tmp/luci-modulecache
}

exit 0
